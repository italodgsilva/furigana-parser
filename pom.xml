<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.shinji2324</groupId>
    <artifactId>furigana-parser</artifactId>
    <version>0.2.0-SNAPSHOT</version>

    <name>Furigana Parser</name>
    <description>
        Tool for adding furigana to Japanese subtitles.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <maven.compiler.release>21</maven.compiler.release>

        <junit.version>5.13.4</junit.version>
        <jackson.version>2.20.0</jackson.version>
        <kuromoji.version>0.9.0</kuromoji.version>
        <jna.version>5.17.0</jna.version>
        <native.maven.plugin.version>0.10.6</native.maven.plugin.version>
    </properties>

    <dependencies>

        <!-- JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Japanese morphological tokenization (bundled IPADIC dictionary) -->
        <dependency>
            <groupId>com.atilika.kuromoji</groupId>
            <artifactId>kuromoji-ipadic</artifactId>
            <version>${kuromoji.version}</version>
        </dependency>

        <!-- Access to the native HarfBuzz library to reduce the bundled font -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>${jna.version}</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>

        <plugins>

            <!-- Java compilation -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- JUnit 5 tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
            </plugin>

            <!-- Executable JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>
                                com.shinji2324.furigana.Application
                            </mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Packages the dependencies into the JAR (e.g. Jackson), allowing java -jar to run -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <!--
                        GUI uber jar, attached with the `gui` classifier. It is
                        declared before the CLI one on purpose: an attached
                        execution shades the thin jar (from maven-jar-plugin),
                        while the CLI execution below replaces the main artifact.
                        Shading the CLI jar first would make this one shade the
                        already-shaded jar, duplicating every class.
                    -->
                    <execution>
                        <id>gui</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>gui</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.shinji2324.furigana.gui.GuiMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                    <!-- CLI uber jar: replaces the main artifact (kept for compatibility). -->
                    <execution>
                        <id>default</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.shinji2324.furigana.Application</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>

    </build>

    <profiles>

        <!--
            Native compilation with GraalVM Native Image (opt-in).

            Requires GraalVM on the PATH/JAVA_HOME (with `native-image`) and a
            C toolchain (gcc + zlib headers). The reflection/resources/JNI
            configurations live in
            src/main/resources/META-INF/native-image/. The AWT/Swing metadata
            for the GUI lives in native-image/gui/ (collected with the tracing
            agent) and native-image/awt/ (generated from the OpenJDK sources,
            see tools/generate-awt-jni-config.py). Both are passed only to the
            GUI image, see below.

            Usage: mvn -Pnative package
            Output: target/furigana-parser (CLI) and target/furigana-parser-gui (GUI)
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>

                    <!--
                        The shade uber jar would duplicate classes and resources
                        on the classpath handed to native-image: the plugin uses
                        the project jar *in addition* to the dependency jars (the
                        Kuromoji dictionary would be included twice, ~40 MB more).
                        In the native build it is skipped; native-image reads
                        target/classes + dependencies. Both executions (the CLI
                        and the GUI uber jars) are disabled.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>gui</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        Two images from the same classes: the CLI one does not
                        reference the GUI, so AWT/Swing stays out of it.
                    -->
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native.maven.plugin.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native-cli</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.shinji2324.furigana.Application</mainClass>
                                    <imageName>furigana-parser</imageName>
                                </configuration>
                            </execution>
                            <execution>
                                <id>build-native-gui</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.shinji2324.furigana.gui.GuiMain</mainClass>
                                    <imageName>furigana-parser-gui</imageName>
                                    <buildArgs>
                                        <!-- All the charsets, for non-ASCII file paths. -->
                                        <buildArg>-H:+AddAllCharsets</buildArg>
                                        <!--
                                            Link the X11 AWT (libawt_xawt) instead of
                                            the headless one, so the window can be
                                            shown. Without it the image defaults to
                                            headless and cannot open a window.
                                        -->
                                        <buildArg>-Djava.awt.headless=false</buildArg>
                                        <!--
                                            AWT/Swing metadata (see
                                            docs/native-image.md). `gui` was
                                            collected with the tracing agent on
                                            Linux and covers the X11 code paths;
                                            `awt` is generated from the OpenJDK
                                            native sources and covers the Windows
                                            and macOS code paths too. Native Image
                                            skips the classes that are absent from
                                            the platform being built. The AWT
                                            native library calls back into Java
                                            (System.load) from its JNI_OnLoad, and
                                            that callback only works with this
                                            registration. It is kept out of the
                                            classpath so the CLI image never pulls
                                            AWT in.
                                        -->
                                        <buildArg>-H:ConfigurationFileDirectories=${project.basedir}/native-image/gui,${project.basedir}/native-image/awt</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>