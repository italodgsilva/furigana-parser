# Builds the two native binaries with GraalVM Native Image and smoke-tests them
# on a clean Debian, under Xvfb (the GUI needs a display).
#
#   docker build -f docker/Dockerfile.native -t furigana-parser-native .
#   docker run --rm furigana-parser-native
#
# The build stage validates `mvn -Pnative package` (both native-maven-plugin
# executions); the test stage validates that the binaries run without GraalVM
# installed, which is the whole point of the native build.

FROM ghcr.io/graalvm/native-image-community:21 AS build

# The image already ships gcc, make and the zlib headers; Maven is the only
# missing piece.
ARG MAVEN_VERSION=3.9.9
WORKDIR /build
RUN curl -fsSL \
      "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
      | tar -xz -C /opt \
 && ln -s "/opt/apache-maven-${MAVEN_VERSION}/bin/mvn" /usr/bin/mvn

COPY pom.xml .
COPY src ./src
COPY native-image ./native-image
RUN mvn --batch-mode --no-transfer-progress -Pnative -DskipTests clean package \
 && ls -l target/furigana-parser target/furigana-parser-gui

FROM debian:bookworm-slim AS test

# Xvfb + the X/font libraries Swing needs at runtime.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      xvfb xauth \
      libx11-6 libxext6 libxrender1 libxtst6 libxi6 \
      libfreetype6 fontconfig fonts-dejavu-core \
      ca-certificates zlib1g \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# The CLI image is self-contained: it gets its own directory so the smoke test
# proves it runs without the GUI's AWT libraries.
COPY --from=build /build/target/furigana-parser /app/cli/furigana-parser
# The GUI image needs the AWT/font JNI libraries that native-image emits next to
# the executable (libawt*, libfontmanager, libjpeg, liblcms and the java/jvm shims).
COPY --from=build /build/target/furigana-parser-gui /app/gui/furigana-parser-gui
COPY --from=build /build/target/*.so /app/gui/
COPY docker/sample.ja.srt /app/sample.ja.srt
COPY docker/smoke-test.sh /app/smoke-test.sh
RUN chmod +x /app/smoke-test.sh

ENTRYPOINT ["/app/smoke-test.sh"]
CMD ["native"]
